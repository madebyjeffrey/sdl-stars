{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-sdl-debug",
      "displayName": "Native Windows SDL3 (MSYS2 UCRT64 Debug)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/windows-sdl-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "STARS_BUILD_SDL_CLIENT": "ON",
        "STARS_SDL_FETCH": "ON"
      }
    },
    {
      "name": "windows-sdl-ide",
      "displayName": "Native Windows SDL3 (MSYS2 UCRT64, IDE targets)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "inherits": "windows-sdl-debug",
      "binaryDir": "${sourceDir}/dist/windows-sdl-ide",
      "cacheVariables": { "STARS_BUILD_TESTS": "OFF" }
    },
    {
      "name": "windows-sdl-release",
      "inherits": "windows-sdl-debug",
      "displayName": "Native Windows SDL3 (MSYS2 UCRT64 Release)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/dist/windows-sdl-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mingw-debug",
      "displayName": "Windows SDL3 (legacy Debug alias)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "inherits": "windows-sdl-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/mingw-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw-release",
      "inherits": "mingw-debug",
      "displayName": "Windows SDL3 (legacy Release alias)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "binaryDir": "${sourceDir}/dist/mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-debug",
      "displayName": "stars-host with the native compiler (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "STARS_BUILD_SDL_CLIENT": "OFF"
      }
    },
    {
      "name": "host-release",
      "inherits": "host-debug",
      "displayName": "stars-host with the native compiler (Release)",
      "binaryDir": "${sourceDir}/dist/host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-host-debug",
      "inherits": "host-debug",
      "displayName": "stars-host for native macOS (Debug)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "binaryDir": "${sourceDir}/dist/macos-host-debug",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": ""
      }
    },
    {
      "name": "macos-host-release",
      "inherits": "macos-host-debug",
      "displayName": "stars-host for native macOS (Release)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "binaryDir": "${sourceDir}/dist/macos-host-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sdl-debug",
      "displayName": "Linux SDL3 compatibility Debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/dist/sdl-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{HOME}/.local/opt/stars-sdl3",
        "STARS_BUILD_SDL_CLIENT": "ON",
        "STARS_SDL_FETCH": "ON"
      }
    },
    {
      "name": "sdl-ide",
      "displayName": "Linux SDL3 development (IDE targets)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "inherits": "sdl-debug",
      "binaryDir": "${sourceDir}/dist/sdl-ide",
      "cacheVariables": { "STARS_BUILD_TESTS": "OFF" }
    },
    {
      "name": "sdl-release",
      "inherits": "sdl-debug",
      "displayName": "Linux SDL3 compatibility Release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/dist/sdl-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sdl-sanitize",
      "inherits": "sdl-debug",
      "displayName": "Linux SDL3 AddressSanitizer / UndefinedBehaviorSanitizer",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/dist/sdl-sanitize",
      "cacheVariables": {
        "STARS_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "macos-sdl-debug",
      "inherits": "sdl-debug",
      "displayName": "macOS SDL3 compatibility Debug (qualification required)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "binaryDir": "${sourceDir}/dist/macos-sdl-debug",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "/opt/homebrew",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "STARS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos-sdl-ide",
      "displayName": "macOS SDL3 development (IDE targets)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "inherits": "macos-sdl-debug",
      "binaryDir": "${sourceDir}/dist/macos-sdl-ide",
      "cacheVariables": { "STARS_BUILD_TESTS": "OFF" }
    },
    {
      "name": "macos-sdl-release",
      "inherits": "macos-sdl-debug",
      "displayName": "macOS SDL3 compatibility Release (qualification required)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "binaryDir": "${sourceDir}/dist/macos-sdl-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "STARS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "macos-bundle",
      "inherits": "macos-sdl-release",
      "displayName": "Signed Apple-silicon macOS app bundle",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "binaryDir": "${sourceDir}/dist/macos-bundle",
      "cacheVariables": { "STARS_MACOS_BUNDLE": "ON", "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0" }
    },
    {
      "name": "sdl-package",
      "inherits": "sdl-release",
      "displayName": "Linux SDL product install (Release)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "binaryDir": "${sourceDir}/dist/sdl-package",
      "cacheVariables": {
        "STARS_BUILD_TESTS": "OFF",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist/install"
      }
    }
  ],
  "buildPresets": [
    { "name": "macos-bundle", "configurePreset": "macos-bundle", "targets": ["stars-macos-bundle"], "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" } },
    { "name": "windows-sdl-debug", "configurePreset": "windows-sdl-debug", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "windows-sdl-ide", "configurePreset": "windows-sdl-ide", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    { "name": "windows-sdl-release", "configurePreset": "windows-sdl-release", "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" } },
    {
      "name": "mingw-debug",
      "displayName": "Build SDL client (legacy Windows Debug alias)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "configurePreset": "mingw-debug"
    },
    {
      "name": "mingw-release",
      "displayName": "Build SDL client (legacy Windows Release alias)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "configurePreset": "mingw-release"
    },
    {
      "name": "host-debug",
      "displayName": "Build stars-host (native Debug)",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-release",
      "displayName": "Build stars-host (native Release)",
      "configurePreset": "host-release"
    },
    {
      "name": "macos-host-debug",
      "displayName": "Build stars-host (x86_64 macOS Debug)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "configurePreset": "macos-host-debug"
    },
    {
      "name": "macos-host-release",
      "displayName": "Build stars-host (x86_64 macOS Release)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "configurePreset": "macos-host-release"
    },
    {
      "name": "sdl-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "configurePreset": "sdl-debug"
    },
    {
      "name": "sdl-ide",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "configurePreset": "sdl-ide"
    },
    {
      "name": "sdl-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "configurePreset": "sdl-release"
    },
    {
      "name": "sdl-sanitize",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "inherits": "sdl-debug",
      "configurePreset": "sdl-sanitize"
    },
    {
      "name": "macos-sdl-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "configurePreset": "macos-sdl-debug"
    },
    {
      "name": "macos-sdl-ide",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "configurePreset": "macos-sdl-ide"
    },
    {
      "name": "macos-sdl-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "configurePreset": "macos-sdl-release"
    },
    {
      "name": "sdl-package",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "configurePreset": "sdl-package",
      "targets": [
        "stars-sdl",
        "stars-host",
        "stars-compat-help-viewer"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "windows-sdl-headless",
      "displayName": "Native Windows SDL UI checks (sequential)",
      "configurePreset": "windows-sdl-debug",
      "filter": { "include": { "name": "^(win32_sdl_|sdl_smoke_|win32_client_|win32_native_tutorial_|sdl_test_|win32_utf8)" } },
      "environment": {
        "SDL_VIDEODRIVER": "dummy",
        "SDL_AUDIODRIVER": "dummy",
        "STARS_SDL_RENDERER": "software",
        "STARS_FILE_DIALOG_BACKEND": "compat"
      },
      "execution": { "jobs": 1, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sdl-headless",
      "displayName": "Invisible SDL UI tests (sequential)",
      "configurePreset": "sdl-debug",
      "environment": {
        "SDL_VIDEODRIVER": "dummy",
        "SDL_AUDIODRIVER": "dummy",
        "STARS_SDL_RENDERER": "software",
        "STARS_FILE_DIALOG_BACKEND": "compat",
        "DISPLAY": null,
        "WAYLAND_DISPLAY": null
      },
      "filter": { "exclude": { "name": "_x11$|wayland" } },
      "execution": { "jobs": 1, "noTestsAction": "error" },
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sdl-headless-sanitize",
      "inherits": "sdl-headless",
      "displayName": "Invisible SDL UI tests with fatal sanitizers",
      "configurePreset": "sdl-sanitize",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1"
      }
    }
  ]
}
