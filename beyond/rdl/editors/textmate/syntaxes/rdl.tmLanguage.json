{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RDL",
  "scopeName": "source.rdl",
  "fileTypes": ["rdl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#imports" },
    { "include": "#type-declarations" },
    { "include": "#component-slots" },
    { "include": "#components" },
    { "include": "#declarations" },
    { "include": "#literals" },
    { "include": "#type-variables" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#trait-applications" },
    { "include": "#properties" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "component-slots": {
      "match": "\\b(requires|allows)\\s+(one|optional|many|some)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.rdl" },
        "2": { "name": "storage.modifier.rdl" },
        "3": { "name": "entity.name.type.rdl" }
      }
    },
    "components": {
      "patterns": [
        {
          "match": "\\b(?:(abstract)\\s+)?(component)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.rdl"
            },
            "2": {
              "name": "storage.type.rdl"
            },
            "3": {
              "name": "entity.name.type.rdl"
            }
          }
        },
        {
          "match": "\\b(provides|modifies)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.rdl"
            },
            "2": {
              "name": "entity.name.type.rdl"
            }
          }
        }
      ]
    },
    "imports": {
      "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
      "captures": {
        "1": { "name": "keyword.control.import.rdl" },
        "2": { "name": "entity.name.namespace.rdl" }
      }
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rdl",
          "begin": "//",
          "end": "$",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.rdl" } }
        },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.rdl",
      "begin": "\\(\\*",
      "end": "\\*\\)",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.rdl" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.rdl" } },
      "patterns": [{ "include": "#block-comment" }]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.rdl",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.rdl" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.rdl" } }
        },
        {
          "name": "string.quoted.double.rdl",
          "begin": "\"",
          "end": "\"|(?=$)",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.rdl" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.rdl" } },
          "patterns": [
            { "name": "constant.character.escape.rdl", "match": "\\\\[nrt\"\\\\]" },
            { "name": "invalid.illegal.escape.rdl", "match": "\\\\." }
          ]
        }
      ]
    },
    "type-declarations": {
      "match": "\\b(?:(trait|object)\\s+)?(type)\\s+((?:'[A-Za-z_][A-Za-z0-9_]*\\s+)*)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.rdl" },
        "2": { "name": "storage.type.rdl" },
        "3": { "name": "entity.name.type.parameter.rdl" },
        "4": { "name": "entity.name.type.rdl" }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(trait|let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.rdl" },
            "2": { "name": "entity.name.variable.rdl" }
          }
        },
        {
          "match": "\\b(derive)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.rdl" },
            "2": { "name": "variable.other.property.rdl" }
          }
        },
        {
          "match": "\\b(from)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.query.rdl" },
            "2": { "name": "variable.other.rdl" }
          }
        },
        {
          "match": "\\b(?!(?:type|trait|object|let|derive|require|query|from|where|select|order|by|with|match|if|then|else|in|of|and|or|not|import)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*=)",
          "captures": {
            "1": { "name": "entity.name.type.rdl" },
            "2": { "name": "entity.name.variable.rdl" }
          }
        }
      ]
    },
    "literals": {
      "patterns": [
        { "name": "constant.language.rdl", "match": "\\b(?:true|false|none|immune)\\b" },
        { "name": "constant.numeric.rdl", "match": "\\b[0-9]+(?:_[0-9]+)*(?:\\.[0-9]+(?:_[0-9]+)*)?(?:[eE][+-]?[0-9]+(?:_[0-9]+)*)?\\b" }
      ]
    },
    "type-variables": { "name": "entity.name.type.parameter.rdl", "match": "'[A-Za-z_][A-Za-z0-9_]*\\b" },
    "keywords": {
      "patterns": [
        { "name": "storage.type.rdl", "match": "\\b(?:abstract|component|type|trait|object|let|derive)\\b" },
        { "name": "keyword.control.rdl", "match": "\\b(?:requires|allows|provides|modifies|compose|multiply|add|in|if|then|else|match|with|of|require|query|from|where|select|order|by|ascending|descending|import)\\b" },
        { "name": "keyword.operator.logical.rdl", "match": "\\b(?:and|or|not)\\b" },
        { "name": "variable.language.rdl", "match": "\\bself\\b" }
      ]
    },
    "types": { "name": "support.type.rdl", "match": "\\b(?:Trait|Int|Integer|Real|String|Bool|int|integer|real|string|bool|option|set|range)\\b" },
    "builtins": {
      "patterns": [
        {
          "match": "\\b(Set|List)(\\.)(contains|size|length|sum|product)\\b",
          "captures": {
            "1": { "name": "support.class.rdl" },
            "2": { "name": "punctuation.accessor.rdl" },
            "3": { "name": "support.function.rdl" }
          }
        },
        { "name": "support.function.rdl", "match": "\\b(?:round|floor|ceil|sqrt|abs|min|max)\\b" }
      ]
    },
    "properties": {
      "patterns": [
        { "name": "variable.other.property.rdl", "match": "(?<=\\.)\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
        { "name": "variable.other.property.rdl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?::|=(?!=)))" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.rdl", "match": "\\.\\." },
        { "name": "keyword.operator.rdl", "match": "->|<=|>=|!=|<>|==|&&|\\|\\||[=+*/%<>|:-]" },
        { "name": "punctuation.accessor.rdl", "match": "\\." },
        { "name": "punctuation.section.rdl", "match": "[{}()\\[\\]]" },
        { "name": "punctuation.separator.rdl", "match": "[;,]" }
      ]
    },
    "trait-applications": { "name": "entity.name.function.rdl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()" },
    "identifiers": { "name": "variable.other.rdl", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
  }
}
