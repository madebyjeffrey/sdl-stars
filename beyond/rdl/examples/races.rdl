(* Illustrative point rules, not Stars! race-pricing formulas. *)

import stars.schema
import stars.prt

trait type secondary_racial_trait = {
  name : string;
  point_cost : integer;
}

trait improved_fuel_efficiency : secondary_racial_trait = {
  name = "Improved Fuel Efficiency";
  point_cost = 10;
}

type 'a habitability =
  | immune
  | 'a range
with (owner : race) {
  derive points : int =
    let modifier =
      if owner.primary = hyper_expansion then 20 else 0
    in
    let trait_cost =
      if Set.contains improved_fuel_efficiency owner.secondary then 10 else 0
    in
    match self with
    | immune -> -100 + modifier + trait_cost
    | range { lower; upper } ->
        round (100.0 - (real upper - real lower)) + modifier + trait_cost;
}

object type race = {
  name : string;
  description : string;
  population : int;
  primary : primary_racial_trait option;
  secondary : secondary_racial_trait set;
  gravity : real habitability;
  temperature : int habitability;
  radiation : integer habitability;

  require self.population >= 0;

  derive habitability_points : int =
    self.gravity.points + self.temperature.points + self.radiation.points;

  derive secondary_points : int =
    List.sum (query {
      from t : secondary_racial_trait
      where Set.contains t self.secondary
      select t.point_cost
    });
}

race terrans = {
  name = "Terrans";
  description = """
    An example race design.

    Unicode text: café, 星.
  """;
  population = 25000;
  primary = hyper_expansion;
  secondary = { improved_fuel_efficiency; };
  gravity = 0.5 .. 2.0;
  temperature = immune;
  radiation = 20 .. 80;
}

race settlers = {
  name = "Settlers";
  description = "A race without optional traits.";
  population = 18000;
  gravity = 0.8 .. 1.2;
  temperature = -20 .. 80;
  radiation = 10 .. 90;
}

object type planet = {
  name : string;
  owner : race option;
}

planet earth = {
  name = "Earth";
  owner = terrans;
}

query {
  from r : race
  order by r.population descending
  select {
    name = r.name;
    points = r.habitability_points;
  }
}
