import stars.design

(* battle.cpp:508,2249,1039. engine_warp is 10 for listed warp-10 engines,
   otherwise the highest warp <=9 with fuel table entry <=120. Loaded mass
   is allocated proportionally by design cargo capacity before this step. *)
type BattleMovement = {
  race: Race;
  engine_warp: integer;
  engine_count: integer;
  loaded_mass: integer;
  thrusters: integer = 0;
  half_thrusters: integer = 0;
  real_fleet: bool = true;
  cargo_dumping: bool = false;
  energy_dampener_present: bool = false;
  starbase: bool = false;
  round: integer = 0;
  require self.engine_count > 0 && self.loaded_mass >= 0 && self.half_thrusters >= 0 && self.round >= 0;
  derive before_dampener: integer = max 0 (min 8
    (self.engine_warp - 4 + self.thrusters + (self.half_thrusters + 1) / 2
     + (if self.real_fleet && self.race.prt_id = 2 then 2 else 0)
     - (if self.cargo_dumping then 1 else 0) - (self.loaded_mass / 70) / self.engine_count));
  derive speed: integer = max 0 (self.before_dampener - (if self.energy_dampener_present && not self.starbase then 4 else 0));
  derive distance_this_round: integer = (self.speed + 2) / 4 +
    (if self.speed % 4 = 0 && self.round % 2 = 0 then 1
     else if self.speed % 4 = 1 && self.round % 4 != 2 then 1
     else if self.speed % 4 = 3 && self.round % 4 = 0 then 1 else 0);
}
(* turn2.cpp:813. survival is the already evaluated defense survival fraction. *)
type GroundCombat = {
  attacker: Race;
  defender: Race;
  arriving_colonists: integer;
  resident_colonists: integer;
  defense_survival: real;
  target_has_base: bool = false;
  require self.arriving_colonists >= 0 && self.resident_colonists >= 0 && self.defense_survival >= 0.0 && self.defense_survival <= 1.0;
  derive can_invade: bool = self.attacker.prt_id != 8 && not self.target_has_base;
  derive attacking_strength: integer = if not self.can_invade then 0 else
    int (real (self.arriving_colonists * (if self.attacker.prt_id = 2 then 165 else 110) / 100)
      * (self.defense_survival + (1.0 - self.defense_survival) / 4.0));
  derive defending_strength: integer = self.resident_colonists * (if self.defender.prt_id = 4 then 2 else 1);
}
(* Repair rates are damage units /500, NOT percent. turn2.cpp:1016. *)
type Repair = {
  race: Race;
  damage: integer;
  moved: bool = false;
  at_planet: bool = false;
  own_planet: bool = false;
  repair_base: bool = false;
  base_has_cargo: bool = false;
  transport_bonus: integer = 0;
  dead: bool = false;
  no_heal: bool = false;
  starbase: bool = false;
  require self.damage >= 0 && self.damage <= 500;
  require self.transport_bonus = 0 || self.transport_bonus = 25 || self.transport_bonus = 50;
  derive location_rate: integer = if self.moved then 5 else if not self.at_planet then 10
    else if not self.own_planet then 15 else if not self.repair_base then 25
    else if self.base_has_cargo then 100 else 40;
  derive rate: integer = if self.dead || self.no_heal then 0 else
    if self.starbase then (if self.race.prt_id = 4 then 75 else 50)
    else self.location_rate * (if self.race.prt_id = 4 then 2 else 1) + self.transport_bonus;
  derive next_damage: integer = max 0 (self.damage - self.rate);
}
(* util.cpp:297,1572; battle.cpp:673. Zero shields do not regenerate. *)
type ShieldArmor = {
  race: Race;
  shield_sum: integer;
  intrinsic_armor: integer;
  armor_part_dp: integer;
  armor_odd_part_count: integer = 0;
  other_armor_dp: integer = 0;
  current_shield: integer = 0;
  battle_round: integer = 1;
  full_detail_current_owner: bool = true;
  require self.shield_sum >= 0 && self.intrinsic_armor >= 0 && self.armor_part_dp >= 0 && self.other_armor_dp >= 0;
  derive shield: integer = min 65535 (self.shield_sum + (if self.race.rs then 2 * self.shield_sum / 5 else 0));
  derive armor: integer = self.intrinsic_armor + self.other_armor_dp +
    (if self.race.rs && self.full_detail_current_owner then (self.armor_part_dp - self.armor_odd_part_count) / 2 else self.armor_part_dp);
  derive regenerated_shield: integer = if self.race.rs && self.current_shield > 0 && self.battle_round >= 1 && self.battle_round <= 15
    then min self.shield (self.current_shield + self.shield / 10) else self.current_shield;
}

(* The source selects a transport bonus in ascending design order. *)
type TransportRepairStep = {
  previous_bonus: integer = 0;
  fuel_transport: bool = false;
  super_fuel_transport: bool = false;
  derive bonus: integer = if self.super_fuel_transport then 50
    else if self.fuel_transport && self.previous_bonus < 5 then 25 else self.previous_bonus;
}
