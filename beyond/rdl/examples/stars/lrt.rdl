import schema

(* The sign is the adjustment ADDED to the internal wizard balance.
   Source: race.cpp rgRaceAdvDisPts; enum bit order in enums.h. *)
trait type LesserTrait = {
  name: string;
  abbreviation: string;
  bit: integer;
  mask: integer;
  point_adjustment: integer;
}

component LrtImprovedFuelEfficiency : SecondaryRacialTrait {
  name = "Improved Fuel Efficiency";
  description = "See stars/rules and docs/RACE-PROPERTIES-AND-TRAIT-EFFECTS.md for executable rules and source references.";
}
trait lrt_ife : LesserTrait {
  name = "Improved Fuel Efficiency";
  abbreviation = "IFE";
  bit = 0; mask = 1; point_adjustment = -235;
  provides LrtImprovedFuelEfficiency
}

component LrtTotalTerraforming : SecondaryRacialTrait {
