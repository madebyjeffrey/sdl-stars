add_executable(stars-resource-audio tests/compat/audio_ownership.cpp)
target_include_directories(stars-resource-audio PRIVATE "${PROJECT_SOURCE_DIR}/compat/win32/src")
target_link_libraries(stars-resource-audio PRIVATE stars_win32 SDL3::SDL3)
target_compile_options(stars-resource-audio PRIVATE -Wall -Wextra -Werror)
stars_test_redirect(stars-resource-audio SDL_PutAudioStreamData)
foreach(STARS_AUDIO_CASE owned external failure muted)
    set(STARS_AUDIO_ENV "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;STARS_SDL_RENDERER=software")
    if(STARS_AUDIO_CASE MATCHES "^(failure|muted)$")
        set(STARS_AUDIO_ENV "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=stars-missing-driver;STARS_SDL_RENDERER=software")
    endif()
    if(STARS_AUDIO_CASE STREQUAL "muted")
        list(APPEND STARS_AUDIO_ENV "STARS_SDL_ALERTS=off")
    endif()
    add_test(NAME win32_sdl_resource_audio_${STARS_AUDIO_CASE} COMMAND stars-resource-audio ${STARS_AUDIO_CASE})
    set_tests_properties(win32_sdl_resource_audio_${STARS_AUDIO_CASE} PROPERTIES LABELS "compat;ownership"
        ENVIRONMENT "${STARS_AUDIO_ENV}" TIMEOUT 30)
    if(APPLE AND NOT STARS_ENABLE_SANITIZERS)
        find_program(STARS_AUDIO_LEAKS_EXECUTABLE leaks REQUIRED)
        add_test(NAME win32_sdl_leaks_audio_${STARS_AUDIO_CASE} COMMAND "${STARS_AUDIO_LEAKS_EXECUTABLE}"
            --quiet --noContent --atExit -- "$<TARGET_FILE:stars-resource-audio>" ${STARS_AUDIO_CASE})
        set_tests_properties(win32_sdl_leaks_audio_${STARS_AUDIO_CASE} PROPERTIES LABELS "compat;ownership;leaks"
            ENVIRONMENT "${STARS_AUDIO_ENV}" RUN_SERIAL TRUE TIMEOUT 60)
    endif()
endforeach()
