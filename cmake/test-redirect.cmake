# Compile-time test substitution, using ordinary function names on every linker.
# A test links private copies of the libraries whose calls it redirects. The
# product libraries are never modified, and identical hook sets share copies.
function(stars_test_clone_library output original key)
    set(clone "${original}-test-${key}")
    if(NOT TARGET "${clone}")
        get_target_property(kind "${original}" TYPE)
        get_target_property(directory "${original}" SOURCE_DIR)
        get_target_property(sources "${original}" SOURCES)
        set(absolute_sources)
        foreach(source IN LISTS sources)
            if(source MATCHES "^\\$<TARGET_OBJECTS:([^>]+)>$")
                stars_test_clone_library(object_clone "${CMAKE_MATCH_1}" "${key}")
                list(APPEND absolute_sources "$<TARGET_OBJECTS:${object_clone}>")
            elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
                list(APPEND absolute_sources "${source}")
            else()
                list(APPEND absolute_sources "${directory}/${source}")
            endif()
        endforeach()
        foreach(source IN LISTS absolute_sources)
            if(NOT source MATCHES "^\\$<")
                foreach(property LANGUAGE COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
                    get_source_file_property(value "${source}" DIRECTORY "${directory}" "${property}")
                    if(value)
                        set_source_files_properties("${source}" PROPERTIES "${property}" "${value}")
                    endif()
                endforeach()
            endif()
        endforeach()
        if(kind STREQUAL "OBJECT_LIBRARY")
            add_library("${clone}" OBJECT EXCLUDE_FROM_ALL ${absolute_sources})
        else()
            add_library("${clone}" STATIC EXCLUDE_FROM_ALL ${absolute_sources})
        endif()
        foreach(property COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
            get_target_property(value "${original}" "${property}")
            if(value)
                set_property(TARGET "${clone}" PROPERTY "${property}" "${value}")
            endif()
        endforeach()
        target_compile_definitions("${clone}" PRIVATE ${STARS_TEST_CALL_DEFINITIONS})
        get_target_property(libraries "${original}" LINK_LIBRARIES)
        if(NOT libraries)
            set(libraries)
        endif()
        foreach(library IN LISTS libraries)
            if(library IN_LIST STARS_TEST_REDIRECT_LIBRARIES)
                stars_test_clone_library(library "${library}" "${key}")
            endif()
            target_link_libraries("${clone}" PUBLIC "${library}")
        endforeach()
        # Retain generated headers/resources and native bridge dependencies.
        add_dependencies("${clone}" "${original}")
    endif()
    set("${output}" "${clone}" PARENT_SCOPE)
endfunction()

function(stars_test_redirect target)
    get_target_property(hooks "${target}" STARS_TEST_HOOKS)
    if(NOT hooks)
        set(hooks)
    endif()
    list(APPEND hooks ${ARGN})
    list(REMOVE_DUPLICATES hooks)
    list(SORT hooks)
    set_property(TARGET "${target}" PROPERTY STARS_TEST_HOOKS "${hooks}")
    get_target_property(scheduled "${target}" STARS_TEST_REDIRECT_SCHEDULED)
    if(NOT scheduled)
        set_property(TARGET "${target}" PROPERTY STARS_TEST_REDIRECT_SCHEDULED TRUE)
        # Capture the target name now, but copy its completed build settings later.
        cmake_language(EVAL CODE "cmake_language(DEFER CALL stars_test_apply_redirect [[${target}]])")
    endif()
endfunction()

function(stars_test_apply_redirect target)
    set(STARS_TEST_REDIRECT_LIBRARIES stars_core stars-ui-compat-check stars_win32
        stars_filedialog_windows)
    set(implementation_hooks AlertSz Random PctPlanetCapacity WriteRt FCreateFile RemoveNativeFile ReplaceNativeFile RenameNativeFile
        ReadRt StreamOpen StreamClose DirtyGame InitInstance PromptPassword AskSaveDialog
        NewGameWizard FNativeSaveFileName TrackPopupMenu MessageBoxA IChooseWindowsFile
        FPromptLegacyRacePassword FNativeOpenFileName AskSaveDialog ICompatChooseFile)
    get_target_property(hooks "${target}" STARS_TEST_HOOKS)
    set(STARS_TEST_CALL_DEFINITIONS)
    foreach(hook IN LISTS hooks)
        set(symbol "${hook}")
        if(WIN32 AND hook MATCHES "^(TrackPopupMenu|MessageBoxA)$")
            set(symbol "StarsCompat_${hook}")
        endif()
        if(hook MATCHES "^(malloc|calloc)$")
            # Redirect explicit allocation sites, never CRT/standard declarations.
            list(APPEND STARS_TEST_CALL_DEFINITIONS "STARS_TEST_ALLOC_${hook}=StarsTest_${hook}")
        else()
            list(APPEND STARS_TEST_CALL_DEFINITIONS "${symbol}=StarsTest_${hook}")
        endif()
        if(hook IN_LIST implementation_hooks)
            # Harness calls to an internal API must also reach its adapter.
            # External SDL calls stay real here so an adapter can delegate.
            target_compile_definitions("${target}" PRIVATE "${symbol}=StarsTest_${hook}")
            list(APPEND STARS_TEST_CALL_DEFINITIONS
                "STARS_TEST_IMPL_${hook}=StarsTestReal_${hook}")
        endif()
    endforeach()
    string(MD5 key "${STARS_TEST_CALL_DEFINITIONS}")
    get_target_property(libraries "${target}" LINK_LIBRARIES)
    set(test_libraries)
    foreach(library IN LISTS libraries)
        if(library IN_LIST STARS_TEST_REDIRECT_LIBRARIES)
            stars_test_clone_library(library "${library}" "${key}")
        endif()
        list(APPEND test_libraries "${library}")
    endforeach()
    set_property(TARGET "${target}" PROPERTY LINK_LIBRARIES "${test_libraries}")
endfunction()
