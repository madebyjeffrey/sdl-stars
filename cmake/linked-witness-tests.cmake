# Every witness links the normal production implementation and real owned types.
# Python supplies independent vectors/oracles and may orchestrate the executable.
function(stars_add_linked_witness name source script)
    set(STARS_LINKED_WITNESS_TARGETS ${STARS_LINKED_WITNESS_TARGETS} stars-witness-${name} PARENT_SCOPE)
    add_executable(stars-witness-${name} "${PROJECT_SOURCE_DIR}/${source}")
    target_link_libraries(stars-witness-${name} PRIVATE stars_core stars-ui-compat-check stars_options stars_win32 SDL3::SDL3)
    target_include_directories(stars-witness-${name} PRIVATE "${PROJECT_SOURCE_DIR}/compat/win32/src")
    target_compile_options(stars-witness-${name} PRIVATE -Wall -Wextra -Wpedantic -Werror -UNDEBUG)
    add_test(NAME witness_${name} COMMAND "${CMAKE_COMMAND}" -E env
        "STARS_WITNESS_EXE=$<TARGET_FILE:stars-witness-${name}>"
        "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/${script}")
    set_tests_properties(witness_${name} PROPERTIES LABELS "witness;ownership"
        ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;STARS_SDL_RENDERER=software;STARS_FILE_DIALOG_BACKEND=compat"
        TIMEOUT 600)
endfunction()
